                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locations\": [\n    {\n      \"locationId\": \"<string>\",\n      \"latitude\": \"<number>\",\n      \"longitude\": \"<number>\"\n    },\n    {\n      \"locationId\": \"<string>\",\n      \"latitude\": \"<number>\",\n      \"longitude\": \"<number>\"\n    }\n  ],\n  \"perils\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
